# pi-monitor configuration
# Copy to ~/.config/pi-monitor/config.env on both the Raspberry Pi and the Host (optional on Host).

# IP address of the Linux Host (running Hyprland + Sunshine)
PI_MONITOR_HOST="192.168.10.1"

# SSH host alias used by the Raspberry Pi to reach the Host
PI_MONITOR_SSH_HOST="laptop"

# SSH host alias used by the Host to reach the Raspberry Pi (used by pi-monitor-host)
PI_MONITOR_PI_SSH_HOST="pi"

# Hyprland virtual output name
PI_MONITOR_OUTPUT="HEADLESS-1"

# Target resolution, refresh rate, and scale
PI_MONITOR_WIDTH="1920"
PI_MONITOR_HEIGHT="1080"
PI_MONITOR_FPS="60"
PI_MONITOR_SCALE="1"

# Default placement relative to the primary monitor (left | right)
PI_MONITOR_DEFAULT_SIDE="right"

# Position offsets in Hyprland (adjust POS_RIGHT to match your primary monitor's logical width)
PI_MONITOR_POS_RIGHT="1920x0"
PI_MONITOR_POS_LEFT="-1920x0"

# Moonlight stream settings
PI_MONITOR_BITRATE="60000"
PI_MONITOR_CODEC="HEVC"
PI_MONITOR_APP_NAME="Desktop"
PI_MONITOR_AUDIO_ON_HOST="1"

# Systemd user unit name for Sunshine on the Host
PI_MONITOR_SUNSHINE_SERVICE="app-dev.lizardbyte.app.Sunshine.service"

# X11 display & authority on the Raspberry Pi (used by moonlight-qt)
PI_MONITOR_DISPLAY=":0"
# PI_MONITOR_XAUTHORITY="$HOME/.Xauthority"
